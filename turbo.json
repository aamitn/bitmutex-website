{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "HOST",
    "DATABASE_CLIENT",
    "DATABASE_HOST",
    "DATABASE_PORT",
    "DATABASE_NAME",
    "DATABASE_USERNAME",
    "DATABASE_PASSWORD",
    "APP_KEYS",
    "API_TOKEN_SALT",
    "TRANSFER_TOKEN_SALT",
    "JWT_SECRET",
    "ADMIN_JWT_SECRET",
    "ADMIN_AUTH_SECRET",
    "STRAPI_BASE_URL",
    "DISABLE_TYPECHECK",
    "AUTO_CREATE_ADMIN"
  ],
  "tasks": {
    "copy": {
      "cache": false,
      "inputs": [".env.example"],
      "outputs": [".env"]
    },
    "dev": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "build": {
      "outputs": [".next/**", "dist/**", ".strapi/**"],
      "cache": true,
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "dependsOn": []
    },
    "backend#build": {
      "outputs": [".strapi/**", "dist/**"],
      "cache": true,
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "dependsOn": []
    },
    "client#build": {
      "outputs": [".next/**"],
      "cache": true,
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "dependsOn": ["backend#build"]
    },
    "start": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "backend#start": {
      "cache": false,
      "interactive": true,
      "persistent": true,
      "dependsOn": ["backend#build"]
    },
    "client#start": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "startci": {
      "cache": false,
      "persistent": true
    },
    "backend#startci": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["backend#build"]
    },
    "client#startci": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true,
      "inputs": ["src/**", "package.json", "tsconfig.json", ".eslintrc*"]
    },
    "develop": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "strapi": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    "package.json"
  ]
}
