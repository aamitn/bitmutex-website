# =============================================================================
# .env — Docker deployment environment variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# =============================================================================

# ── Strapi secrets (generate with: openssl rand -base64 32) ─────────────────
APP_KEYS="key1base64,key2base64"
API_TOKEN_SALT=changeme32charmin
ADMIN_JWT_SECRET=changeme32charmin
TRANSFER_TOKEN_SALT=changeme32charmin
JWT_SECRET=changeme32charmin
ENCRYPTION_KEY=changeme32charminchangeme32char

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_NAME=strapi-bitmutex
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=1234qwer

# ── URLs ─────────────────────────────────────────────────────────────────────
# Internal Next → Strapi URL (always localhost inside the same container)
STRAPI_BASE_URL=http://localhost:1337

# Publicly reachable Strapi URL (browser websockets need the real domain/IP)
NEXT_PUBLIC_STRAPI_BASE_URL=https://api.yourdomain.com

NEXT_PUBLIC_BASE_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# ── Preview ──────────────────────────────────────────────────────────────────
PREVIEW_SECRET=your-secret-key

# ── SMTP (shared by Strapi & Next) ───────────────────────────────────────────
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_DEFAULT_FROM=noreply@yourdomain.com
SMTP_DEFAULT_REPLY_TO=support@yourdomain.com
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password

# ── Strapi admin auto-create ─────────────────────────────────────────────────
AUTO_CREATE_ADMIN=false
ADMIN_EMAIL=admin@yourdomain.com
# bcrypt hash (10 rounds) of your admin password
ADMIN_PASSWORD=$2a$10$joIlSsHxTGdb8XT7cfcVzO5JgUiQSWgbFwbNrT2D/sMbuyhc2y9zW

# ── Discord live-chat ────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ID=

# ── Algolia ──────────────────────────────────────────────────────────────────
ALGOLIA_APP_ID=test
ALGOLIA_ADMIN_KEY=gtest
NEXT_PUBLIC_ALGOLIA_APP_ID=test
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=gtest

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_MICROSOFT_CLARITY=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TRUSTPILOT_INTENT_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.yourdomain.com
NEXT_PUBLIC_APPOINTMENT_URL=https://cal.com/youraccount
NEXT_PUBLIC_GITHUB_TOKEN=
NEXT_PUBLIC_STREAM_KEY=
NEXT_PUBLIC_IMAGES_UNOPTIMIZED=false
IMAGE_HOSTNAME=yourdomain.com

# ── Port overrides (optional) ────────────────────────────────────────────────
STRAPI_PORT=1337
NEXT_PORT=3000


